# ─────────────────────────────────────────────
# PaySnap .gitignore
# ─────────────────────────────────────────────

# Python cache — auto-generated, never commit
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# Database — auto-generated by build_db.py
# Judges run: python data/build_db.py to recreate it
data/labor_law.db

# Security — encryption keys and vault
*.enc
.key
.paysnap/

# Environment variables
.env
.env.local
.env.production

# Mac system files
.DS_Store
.AppleDouble
.LSOverride

# VS Code settings (optional — remove if you want to share)
.vscode/
*.code-workspace

# Node / React — 500MB+, judges run npm install
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# Ollama models — too large for GitHub (9.6GB)
*.gguf
*.bin
*.safetensors

# Fine-tuned model weights — publish separately on HuggingFace
finetune/model_output/

# Temp files created during OCR
/tmp/paysnap_*

# Logs
*.log
logs/

# Test artifacts
.coverage
htmlcov/

# DOL enforcement CSV files — too large for GitHub
# Download from: data.dol.gov/datasets/10246
data/LOAD*.csv
data/whd_*.csv

# Fine-tuning processed data — published on Kaggle
# https://www.kaggle.com/datasets/aadarshpraveen/paysnap-labor-law-dataset
finetune/dataset/processed/
finetune/dataset/raw/